---
/**
 * /v2 — Portfolio redesign (in progress). Isolated from the live homepage.
 * PHASE 2 foundation: layout + theme system + hero philosophy placeholder.
 * Ship system, Selected Work, Process, About, Contact land in later phases.
 */
import V2Layout from '../layouts/V2Layout.astro';
---

<V2Layout title="Jitesh Thakker — Product Designer (v2)">
  <section class="v2-hero">
    <div class="v2-wrap">
      <p class="v2-eyebrow">Product Designer · Bengaluru</p>
      <h1>I design to learn,<br /><span class="muted">not just to ship.</span></h1>
      <p class="v2-sub">
        I design digital products — but I'm just as interested in what happens
        after they leave the file: whether they get used, whether they hold up,
        and what they teach us next.
      </p>
      <p class="v2-note">
        v2 foundation · theme system live (try the toggle top-right) · ship
        system + sections coming next.
      </p>
    </div>
  </section>
</V2Layout>
