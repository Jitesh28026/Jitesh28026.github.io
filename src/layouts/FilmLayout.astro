---
/**
 * Minimal layout for the scroll-scrub film.
 *
 * Deliberately NOT BaseLayout. That layout globally injects Lenis smooth
 * scroll, a Loader, a Footer and the headlights overlay — all of which fight
 * a full-screen pinned-canvas experience:
 *
 *   - Lenis eases scroll on its own clock while ScrollTrigger reads native
 *     scroll position, so the painted frame lags the scroll you feel.
 *   - A footer under a seamless loop breaks the "life that keeps turning"
 *     illusion.
 *   - The headlights sweep fights the locked amber/teal grade.
 *
 * Only the <head> is shared in spirit: same SEO/OG shape, nothing in <body>.
 */
import '../styles/film.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'A scroll driven cinematic journey through a flat at night.',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <!--
      Inter, for the opening title.

      This layout previously loaded no fonts at all, so the film fell back to
      generic system faces while the CSS asked for others.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500&display=swap"
    />

    <!-- The first frame is the largest contentful paint; fetch it early. -->
    <link rel="preload" as="image" href="/frames/scene1/0001.webp" />
  </head>
  <body>
    <slot />
  </body>
</html>
