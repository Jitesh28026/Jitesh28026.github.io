---
/**
 * Selected Work — evidence behind the philosophy. Real projects only (mirrors
 * the live work data); no invented metrics. Editorial list, not identical cards.
 */
type Project = {
  n: string;
  title: string;
  context: string;
  blurb: string;
  tags: string[];
  href: string;
  external: boolean;
};

const projects: Project[] = [
  {
    n: '01',
    title: "When read-only wasn't good enough",
    context: 'dataX.ai · B2B catalogue',
    blurb:
      'Found and resolved a permission asymmetry in the B2B catalogue — attributes editable in one place, read-only in another — that was quietly blocking data quality and AI enrichment.',
    tags: ['Edit + review flow', 'Permission asymmetry'],
    href: '/work/edit-feature',
    external: false,
  },
  {
    n: '02',
    title: 'Making data consolidation feel safe',
    context: 'dataX.ai · Supplier MDM',
    blurb:
      'Designed the Supplier Details, Merge & Split flows for an AI-powered master-data platform — a governed, reversible way to combine records without anything moving silently.',
    tags: ['4-step merge flow', 'Enterprise governance'],
    href: '/work/supplier-master',
    external: false,
  },
  {
    n: '03',
    title: 'Fixing offer approvals',
    context: 'Vasitum · HR tech',
    blurb:
      'End-to-end UX for the offer-rollout process — untangling a complex approval workflow and the candidate experience around it.',
    tags: ['Approval flow', 'Candidate experience'],
    href: 'https://medium.com/@thakker.jitesh04/offer-rollout-at-vasitum-342539f4c8f1',
    external: true,
  },
  {
    n: '04',
    title: 'The moment after the money',
    context: 'MoneyHi (GreedyGame) · Retention',
    blurb:
      'A post-cashout retention concept — a tier-based momentum mechanic that creates a revenue-neutral reason to come back within the week.',
    tags: ['Retention', 'Concept'],
    href: 'https://www.figma.com/deck/18aSPWuhIeyu9T6I9Y0Qhn',
    external: true,
  },
];
---

<section class="v2-work" id="work">
  <div class="v2-wrap">
    <header class="sec-head">
      <p class="v2-eyebrow">Selected work</p>
      <h2 class="sec-title">Things I shipped. Things I learned.</h2>
    </header>

    <ol class="work-list">
      {
        projects.map((p) => (
          <li class="work-item">
            <a
              class="work-link"
              href={p.href}
              target={p.external ? '_blank' : undefined}
              rel={p.external ? 'noopener noreferrer' : undefined}
            >
              <span class="work-n">{p.n}</span>
              <div class="work-main">
                <div class="work-context">{p.context}</div>
                <h3 class="work-title">{p.title}</h3>
                <p class="work-blurb">{p.blurb}</p>
                <div class="work-tags">
                  {p.tags.map((t) => (
                    <span class="work-tag">{t}</span>
                  ))}
                </div>
              </div>
              <span class="work-arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .v2-work { padding: clamp(4rem, 10vh, 8rem) 0; }
  .sec-head { margin-bottom: clamp(2.5rem, 6vh, 4.5rem); }
  .sec-title {
    margin-top: 1rem;
    font-weight: 600;
    font-size: clamp(1.9rem, 4vw, 3rem);
    letter-spacing: -0.03em;
    line-height: 1.05;
    max-width: 18ch;
  }

  .work-list { list-style: none; }
  .work-item { border-top: 1px solid var(--line); }
  .work-item:last-child { border-bottom: 1px solid var(--line); }

  .work-link {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: clamp(1rem, 4vw, 3rem);
    align-items: start;
    padding: clamp(1.8rem, 4vh, 3rem) 0;
    text-decoration: none;
    color: var(--ink);
  }
  .work-n {
    font-size: 0.85rem;
    color: var(--ink-3);
    font-variant-numeric: tabular-nums;
    padding-top: 0.5rem;
  }
  .work-context {
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
  }
  .work-title {
    margin-top: 0.6rem;
    font-weight: 600;
    font-size: clamp(1.35rem, 2.6vw, 2rem);
    letter-spacing: -0.02em;
    line-height: 1.1;
    transition: color 0.2s ease;
  }
  .work-blurb {
    margin-top: 0.9rem;
    max-width: 58ch;
    color: var(--ink-2);
    font-size: 0.98rem;
    line-height: 1.6;
  }
  .work-tags { margin-top: 1.1rem; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .work-tag {
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-2);
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.3rem 0.7rem;
  }
  .work-arrow {
    font-size: 1.3rem;
    color: var(--ink-3);
    padding-top: 0.4rem;
    transition: transform 0.25s ease, color 0.2s ease;
  }
  .work-link:hover .work-title { color: var(--ink); }
  .work-link:hover .work-arrow { transform: translate(3px, -3px); color: var(--ink); }
  .work-link:focus-visible { outline: 2px solid var(--ink); outline-offset: 4px; }

  @media (max-width: 720px) {
    .work-link { grid-template-columns: auto 1fr; }
    .work-arrow { display: none; }
  }
</style>
