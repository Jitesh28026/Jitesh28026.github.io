---
/**
 * About — the person behind the way of thinking. Copy is the real bio from the
 * live About page (condensed), not invented. Carries a quiet ship motif.
 */
import Ship from './Ship.astro';
---

<section class="v2-about" id="about">
  <div class="v2-wrap about-grid">
    <div class="about-copy">
      <p class="v2-eyebrow">Beyond the work</p>
      <h2 class="sec-title">A designer who thinks <span class="muted">in systems.</span></h2>

      <div class="about-body">
        <p>
          I'm Jitesh, a product designer in Bengaluru, mostly working after
          everyone else has logged off.
        </p>
        <p>
          I work on B2B problems where the edge cases outnumber the happy paths,
          and the stakeholders have opinions about everything except the user.
        </p>
        <p>
          I think in systems the same way I think about hosting people: what
          makes someone feel welcomed, oriented, safe to look around. Most of
          design, for me, is just that.
        </p>
        <p class="about-aside">
          Off the clock: planning trips I won't take, losing ranked matches,
          blaming the matchmaking.
        </p>
        <a class="about-more" href="/about">Read the full story <span aria-hidden="true">→</span></a>
      </div>
    </div>

    <div class="about-ship-wrap" aria-hidden="true">
      <div class="about-ship"><Ship /></div>
      <p class="about-ship-cap">Still the same ship, from a different angle.</p>
    </div>
  </div>
</section>

<style>
  .v2-about { padding: clamp(4rem, 10vh, 8rem) 0; }
  .about-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .about-copy .sec-title .muted { color: var(--ink-3); }
  .about-body { margin-top: 2rem; max-width: 52ch; }
  .about-body p {
    color: var(--ink-2);
    line-height: 1.7;
    font-size: clamp(1rem, 1.4vw, 1.12rem);
  }
  .about-body p + p { margin-top: 1.25rem; }
  .about-body .about-aside { color: var(--ink-3); font-size: 0.95rem; }
  .about-more {
    display: inline-block;
    margin-top: 1.75rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.3rem;
    transition: border-color 0.2s ease;
  }
  .about-more:hover { border-color: var(--ink); }
  .about-more span { display: inline-block; transition: transform 0.2s ease; }
  .about-more:hover span { transform: translateX(3px); }

  .about-ship-wrap { text-align: center; }
  .about-ship {
    width: min(80%, 380px);
    margin: 0 auto;
    opacity: 0.9;
    transform: scaleX(-1);
  }
  .about-ship-cap {
    margin-top: 1rem;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--ink-3);
    font-style: italic;
  }

  @media (max-width: 860px) {
    .about-grid { grid-template-columns: 1fr; gap: 2.5rem; }
    .about-ship { width: min(62%, 300px); }
  }
</style>
