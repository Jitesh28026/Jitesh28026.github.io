---
/**
 * Ship — reproduces the complete Figma SVG *exactly*: clipPath + mask0..3 +
 * the nested <g> hierarchy are kept intact, so the assembled ship is
 * byte-for-byte the original (identical masking / overlap / float).
 *
 * We only:
 *  1. give the clip/mask ids a unique suffix (so multiple ships can coexist),
 *  2. swap the ink colour #373D3B -> currentColor (mask-alpha/luminance
 *     values are unaffected), so the ship draws in var(--ship) per theme,
 *  3. wrap each piece's path run in a `<g class="ship-piece" data-piece>` —
 *     WITHOUT reordering — so each piece can be transformed independently for
 *     separate/reassemble while the clip/mask relationships stay intact.
 *
 * The two structural clipping groups (mask1 = waterline float, mask2 = ship
 * region) are tagged so they can be relaxed while pieces are scattered, then
 * re-applied when reassembled (keeping the flag's mask3 always on).
 */
import svgRaw from '../../assets/ship/complete-figma.svg?raw';

const uid = 'sh' + Math.random().toString(36).slice(2, 8);

let svg = svgRaw
  // unique clip/mask ids
  .replace(/_2109_56/g, `_${uid}`)
  // theme ink (masks use white / alpha — unaffected in practice)
  .replace(/#373D3B/g, 'currentColor')
  // responsive sizing + let strokes overflow tight bounds
  .replace(
    /<svg /,
    '<svg preserveAspectRatio="xMidYMid meet" style="width:100%;height:auto;display:block;overflow:visible" '
  );

// tag the two structural clipping groups so we can relax them mid-animation
svg = svg
  .replace(/<g mask="url\(#mask1_/, '<g class="ship-clip ship-clip-float" mask="url(#mask1_')
  .replace(/<g mask="url\(#mask2_/, '<g class="ship-clip ship-clip-region" mask="url(#mask2_');

// wrap each piece's paint run in a transformable group (order preserved)
svg = svg
  .replace(
    /(<g mask="url\(#mask3_[\s\S]*?<path d="M513\.734[\s\S]*?\/>)/,
    '<g class="ship-piece" data-piece="flag">$1</g>'
  )
  .replace(
    /(<path d="M323\.953[\s\S]*?\/>)/,
    '<g class="ship-piece" data-piece="body">$1</g>'
  )
  .replace(
    /(<path d="M1073\.76[\s\S]*?)(<path d="M878\.913)/,
    '<g class="ship-piece" data-piece="right-piece">$1</g>$2'
  )
  .replace(
    /(<path d="M878\.913[\s\S]*?)(<path d="M837\.704)/,
    '<g class="ship-piece" data-piece="middle-top">$1</g>$2'
  )
  .replace(
    /(<path d="M837\.704[\s\S]*?)(<path d="M985\.971)/,
    '<g class="ship-piece" data-piece="middle-bottom">$1</g>$2'
  )
  .replace(
    /(<path d="M985\.971[\s\S]*?)(<path d="M583\.037)/,
    '<g class="ship-piece" data-piece="body">$1</g>$2'
  )
  .replace(
    /(<path d="M583\.037[\s\S]*?)(<\/g>)/,
    '<g class="ship-piece" data-piece="vertical-piece">$1</g>$2'
  )
  .replace(
    /(<path d="M239\.508[\s\S]*?\/>)/,
    '<g class="ship-piece" data-piece="waves">$1</g>'
  );
---

<div class="ship-stage" data-ship aria-hidden="true" set:html={svg} />

<style>
  .ship-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    color: var(--ship);
  }
  .ship-stage :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  /* each piece is transformable around its own centre */
  .ship-stage :global(.ship-piece) {
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }
  /* while scattered, relax the two structural clips so pieces move freely and
     stay fully visible (the flag's mask3 stays on). Re-applied when assembled
     so the resting ship is byte-perfect. */
  .ship-stage.is-separated :global(.ship-clip-float),
  .ship-stage.is-separated :global(.ship-clip-region) {
    mask: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .ship-stage :global(.ship-piece) {
      transition: none;
    }
  }
</style>
