---
/**
 * Ship — the recurring visual system, built from the 7 individual SVG pieces.
 * Pieces are inlined via compile-time `?raw` imports (platform-independent —
 * no runtime fs), with #373D3B swapped to currentColor so the ship draws in
 * var(--ship) and adapts to light/dark automatically. Each piece is a live DOM
 * element GSAP can transform independently.
 *
 * Positions are the calibrated 1600x1600 offsets (verified against the Figma
 * render) as % of the square stage. Paint order = DOM order:
 * body -> cargo stack -> flag -> waves. Waves are the FRONT-most layer (the
 * waterline crosses in front of the hull, so the ship reads as floating).
 */
import flagRaw from '../../assets/ship/flag.svg?raw';
import verticalRaw from '../../assets/ship/vertical-piece.svg?raw';
import middleTopRaw from '../../assets/ship/middle-top.svg?raw';
import middleBottomRaw from '../../assets/ship/middle-bottom.svg?raw';
import rightRaw from '../../assets/ship/right-piece.svg?raw';
import bodyRaw from '../../assets/ship/body.svg?raw';
import wavesRaw from '../../assets/ship/waves.svg?raw';

// id -> [raw svg, left%, top%, width%]  (of the 1600 square stage)
const PIECES: [string, string, number, number, number][] = [
  ['body', bodyRaw, 18.75, 50.5, 66.875],
  ['vertical-piece', verticalRaw, 23.125, 40.31, 15.1875],
  ['middle-bottom', middleBottomRaw, 31.5625, 52.0, 22.0],
  ['middle-top', middleTopRaw, 31.8125, 46.25, 21.3125],
  ['right-piece', rightRaw, 52.8125, 53.4375, 15.4375],
  ['flag', flagRaw, 28.0, 33.9375, 4.875],
  ['waves', wavesRaw, 15.31, 71.25, 67.75],
];

function themed(raw: string): string {
  return raw
    .replace(/#373D3B/g, 'currentColor')
    .replace(
      /<svg /,
      '<svg preserveAspectRatio="xMidYMid meet" style="width:100%;height:auto;display:block;overflow:visible" '
    );
}
---

<div class="ship-stage" data-ship aria-hidden="true">
  {
    PIECES.map(([id, raw, left, top, width]) => (
      <div
        class="ship-piece"
        data-piece={id}
        style={`left:${left}%;top:${top}%;width:${width}%`}
        set:html={themed(raw)}
      />
    ))
  }
</div>

<style>
  .ship-stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    color: var(--ship);
  }
  .ship-piece {
    position: absolute;
    will-change: transform, opacity;
    transition: transform 1s cubic-bezier(0.65, 0, 0.35, 1);
  }
  @media (prefers-reduced-motion: reduce) {
    .ship-piece {
      transition: none;
    }
  }
  .ship-piece :global(svg) {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
</style>
